FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY airbreda/dashboard.py .
COPY airbreda/predict.py .
COPY airbreda/dashboard.html .
# predict.py loads model/model.pkl relative to itself
COPY airbreda/model/model.pkl model/

EXPOSE 8000
CMD ["uvicorn", "dashboard:app", "--host", "0.0.0.0", "--port", "8000"]
